{
    "name": "kaveraa/laravel-keycloak-sanctum",
    "description": "Connexion Keycloak (SSO) pour une SPA avec une API Laravel : jeton Sanctum, rôles, déconnexion depuis Keycloak (back-channel logout) et après inactivité.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "keycloak",
        "sanctum",
        "sso",
        "oidc",
        "openid-connect",
        "spa",
        "socialite",
        "backchannel-logout",
        "authentication"
    ],
    "authors": [
        {
            "name": "Augustin Kavera",
            "homepage": "https://github.com/kaveraa"
        }
    ],
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.10 || ^7.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.15",
        "socialiteproviders/keycloak": "^5.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Kaveraa\\KeycloakSanctum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaveraa\\KeycloakSanctum\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kaveraa\\KeycloakSanctum\\KeycloakSanctumServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
